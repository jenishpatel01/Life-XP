# LIFE//XP server configuration
PORT=8787
# Where the SQLite database lives
DATABASE_PATH=./data/lifexp.db
# Set to 1 in production behind HTTPS so cookies are Secure
COOKIE_SECURE=0
# Minimum seconds between STARTING a quest and COMPLETING it (anti-script guard)
MIN_QUEST_SECONDS=3
# Optional: e-mail the password-reset code via https://brevo.com (free, HTTP API).
# If BREVO_API_KEY is empty, the code is printed in the server console instead.
BREVO_API_KEY=
# A sender address you verified in Brevo
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=LIFE//XP
