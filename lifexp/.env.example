# LIFE//XP server configuration
PORT=8787
# Where the SQLite database lives
DATABASE_PATH=./data/lifexp.db
# Set to 1 in production behind HTTPS so cookies are Secure
COOKIE_SECURE=0
# Minimum seconds between STARTING a quest and COMPLETING it (anti-script guard)
MIN_QUEST_SECONDS=3
# Public URL of the site (used in password-reset links)
APP_URL=http://localhost:5173
# Optional: e-mail delivery of reset links via https://resend.com. If empty, the link is printed in the server console.
RESEND_API_KEY=
MAIL_FROM=LIFE//XP <onboarding@resend.dev>
